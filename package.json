{
  "name": "scad-live",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .github client/index.html client/public client/src scripts tests package.json vite.config.js client/svelte.config.js .prettierrc",
    "format:check": "prettier --check .github client/index.html client/public client/src scripts tests package.json vite.config.js client/svelte.config.js .prettierrc",
    "check:runes": "node scripts/check-runes.mjs",
    "check": "svelte-check --config ./client/svelte.config.js --fail-on-warnings && npm run check:runes",
    "test:docs": "sh tests/docs-policy.sh",
    "test:release": "sh tests/release-contract.sh",
    "test:unit": "vitest run",
    "build": "vite build",
    "test:e2e": "playwright test --config tests/playwright.config.js"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "acorn": "8.15.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.54.0",
    "svelte-check": "4.7.3",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.7"
  }
}
